# Copy to .env (git-ignored) and fill in. Every value here can also be passed
# explicitly to the settings objects -- the environment is one source, not the
# source. One file serves every package: each reads only its own section.

# ---------------------------------------------------------------------------
# MultiSet VPS  ->  multiset.vps.VPSSettings
# ---------------------------------------------------------------------------
# These belong to your MultiSet account and are the same for every device you
# run, which is why they live in the core package rather than a device's.
MULTISET_CLIENT_ID=
MULTISET_CLIENT_SECRET=
MULTISET_MAP_CODE=MAP_XXXXXXXXXX

# Optional: sent as queryMode on every localize call.
# MULTISET_QUERY_MODE=vps-2
# Optional: override the API root (the dev API needs its own credentials).
# MULTISET_API_BASE=https://api.multiset.ai/v1
# Optional: use this file instead of searching upward from the cwd for .env.
# MULTISET_ENV=/etc/multiset/.env

# ---------------------------------------------------------------------------
# Unitree Go2  ->  multiset.unitree.go2.Go2Settings
# ---------------------------------------------------------------------------
# The GO2 HEAD UNIT's address: the computer that serves WebRTC and has ONLY
# port 9991 open. A Go2 with a Jetson carrier board puts TWO hosts on your
# wifi; the other one (SSH + the unitree-upgrade web page) never speaks WebRTC,
# and pointing GO2_IP at it fails in a way that looks like a broken robot.
#   Find it from your router's lease table, the Unitree app, or the robot's
#   own screen. It is the host with ONLY port 9991 open.
GO2_IP=192.168.1.100

# Per-device AES-128 key, required on Go2 firmware >= 1.1.15. It lives in
# Unitree's cloud against the account the robot is bound to; nothing can derive
# it locally.
#   go2-credentials --email you@example.com --save
GO2_AES_KEY=
GO2_SN=

# The Jetson board, if you have one. SSH and the upgrade UI live here. Recorded
# for convenience only -- it is never a substitute for GO2_IP.
GO2_JETSON_IP=
